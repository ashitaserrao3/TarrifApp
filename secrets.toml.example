# Template for Streamlit Secrets.
# - Community Cloud: paste the real values into App settings -> Secrets
# - Local run: copy this file to .streamlit/secrets.toml (git-ignored)
#
# Passwords must be bcrypt hashes. Create one with:  python generate_password.py

[cookie]
name = "freight_platform_cookie"
key = "replace-with-a-long-random-string"
expiry_days = 30

[credentials.usernames.ashita]
name = "Ashita Serrao"
password = "$2b$12$...hash..."

[credentials.usernames.another_user]
name = "Another User"
password = "$2b$12$...hash..."


# Lets the ashita account publish new tariffs from the app. They're kept in a private
# Supabase Storage bucket (not in GitHub) and loaded back whenever the app restarts.
# url: Supabase -> Project Settings -> Data API -> Project URL
# key: Supabase -> Project Settings -> API Keys -> the secret key (or the legacy service_role key)
[supabase]
url = "https://xxxxxxxx.supabase.co"
key = "..."
bucket = "tariffs"
